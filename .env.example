# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Application settings
LOG_LEVEL=INFO
MAX_TOKENS=8192
MODEL=claude-opus-4-6

# --- Internal API (src/internal_api.py) -------------------------------------
# Used only by the internal-only finance-core service consumed by server/
# (the TypeScript backend). NOT the same as the legacy public src/api.py.
# Must match PYTHON_SERVICE_URL's INTERNAL_API_TOKEN in server/.env.
INTERNAL_API_TOKEN=change-me-to-a-long-random-value

# --- Legacy public API (src/api.py) — deprecated, see IMPLEMENTATION_PLAN.md
# Required only if you still run the old FastAPI app directly.
DATABASE_URL=postgresql://user:password@localhost:5432/financial_agent
