{
  "name": "@fra/server",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript backend for the AI Financial Research Copilot (Fastify + LangChain.js + pgvector)",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/infra/db/migrate-cli.ts",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION_TESTS=1 vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@langchain/anthropic": "^1.5.10",
    "@langchain/core": "^1.2.11",
    "@langchain/openai": "^1.5.8",
    "@langchain/textsplitters": "^1.0.1",
    "dotenv": "^18.0.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9",
    "vitest": "^4.1.11"
  }
}
