# Copy to .env and fill in. See ../README.md for a full explanation of each
# variable and IMPLEMENTATION_PLAN.md for the architecture these map to.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# --- Database (PostgreSQL + pgvector) ---------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_agent
# Apply pending migrations automatically on boot. Set to false in production
# and run `npm run migrate` as an explicit deploy step instead.
AUTO_MIGRATE=true

# --- Internal Python service (src/internal_api.py — NOT publicly exposed) --
PYTHON_SERVICE_URL=http://localhost:8001
# Must match INTERNAL_API_TOKEN in the repo root .env used to run internal_api.py
INTERNAL_API_TOKEN=change-me-to-a-long-random-value
PYTHON_REQUEST_TIMEOUT_MS=120000

# --- Uploads ------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=52428800
INGEST_CONCURRENCY=2

# --- Auth: comma-separated "key:ownerId" pairs. Placeholder auth — see -----
# --- IMPLEMENTATION_PLAN.md §2 ("Auth (Phase 2)"). Generate real random keys.
API_KEYS=dev-key-1:demo-owner

# --- Embeddings — Anthropic has no embeddings API, so this is a separate ---
# --- provider from LLM_PROVIDER below. "fake" is for tests only. ----------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=

# --- LLM (answer generation) — defaults follow CLAUDE.md conventions ------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-6
LLM_MAX_TOKENS=2048
ANTHROPIC_API_KEY=

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=8
# Cosine-similarity floor below which a chunk is treated as irrelevant.
# Leave unset until calibrated against the Phase 6 eval set (plan risk R8).
MIN_RELEVANCE=
